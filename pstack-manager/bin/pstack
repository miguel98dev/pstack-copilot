#!/bin/sh
# Runs the TypeScript manager with Node's built-in type stripping (Node 22.18+ or 23.6+).
self=$0
while [ -L "$self" ]; do
	link=$(readlink "$self")
	case $link in
	/*) self=$link ;;
	*) self=$(dirname "$self")/$link ;;
	esac
done
version=$(node -p 'process.versions.node' 2>/dev/null) || { echo "pstack needs Node.js 22.18 or later." >&2; exit 127; }
major=${version%%.*}
rest=${version#*.}
minor=${rest%%.*}
if [ "$major" -lt 22 ] || { [ "$major" -eq 22 ] && [ "$minor" -lt 18 ]; } || { [ "$major" -eq 23 ] && [ "$minor" -lt 6 ]; }; then
	echo "pstack needs Node.js 22.18+ or 23.6+ (found $version)." >&2
	exit 127
fi
exec node --disable-warning=ExperimentalWarning "$(dirname "$self")/pstack.mjs" "$@"
